 ],
 "legendas": [
  {
   "ini": 0.8,
   "fim": 2.56,
   "texto": "El mar empieza a subir."
  },
  {
   "ini": 3.86,
   "fim": 4.28,
   "texto": "Un metro."
  },
  {
   "ini": 4.92,
   "fim": 5.54,
   "texto": "Dos."
  },
  {
   "ini": 6.42,
   "fim": 6.92,
   "texto": "Tres."
  },
  {
   "ini": 7.84,
   "fim": 8.66,
   "texto": "Y no se detiene."
  },
  {
   "ini": 10.28,
   "fim": 19.12,
   "texto": "La regla es simple: cuando el noventa y nueve por ciento de la gente de un país queda bajo el agua, ese país desaparece del mapa."
  },
  {
   "ini": 20.34,
   "fim": 22.08,
   "texto": "Veinte países de Latinoamérica."
  },
  {
   "ini": 23.1,
   "fim": 24.42,
   "texto": "Solo uno quedará en pie."
  },
  {
   "ini": 25.42,
   "fim": 27.6,
   "texto": "Y no es el que tiene la montaña más alta."
  },
  {
   "ini": 28.9,
   "fim": 34.4,
   "texto": "A cinco metros, el agua ya entra en las casas de dieciocho millones de personas."
  },
  {
   "ini": 35.34,
   "fim": 40.8,
   "texto": "Cancún, el malecón de Salinas, en Ecuador: la orilla deja de existir."
  },
  {
   "ini": 41.84,
   "fim": 44.58,
   "texto": "A diez metros, son cuarenta y cuatro millones."
  },
  {
   "ini": 45.78,
   "fim": 52.62,
   "texto": "Y a treinta, el mar ya está en el Malecón de La Habana, en Cartagena, en la Ciudad de Panamá, en Maracaibo."
  },
  {
   "ini": 53.54,
   "fim": 57.41,
   "texto": "Río de Janeiro ya no tiene playa: tiene mar en la avenida."
  },
  {
   "ini": 59.02,
   "fim": 62.02,
   "texto": "A treinta metros cae Buenos Aires."
  },
  {
   "ini": 62.94,
   "fim": 65.38,
   "texto": "Diez metros más, y cae Montevideo."
  },
  {
   "ini": 66.38,
   "fim": 68.24,
   "texto": "El Río de la Plata ya no es un río."
  },
  {
   "ini": 68.84,
   "fim": 73.22,
   "texto": "Es un brazo del océano que avanza tierra adentro, hacia Paraguay."
  },
  {
   "ini": 74.54,
   "fim": 81.22,
   "texto": "Cincuenta metros: uno de cada cuatro latinoamericanos ya vive bajo el agua."
  },
  {
   "ini": 83.02,
   "fim": 84.18,
   "texto": "Setenta metros."
  },
  {
   "ini": 85.46,
   "fim": 86.72,
   "texto": "Aquí hay que hacer una pausa."
  },
  {
   "ini": 88.06,
   "fim": 95.16,
   "texto": "Setenta metros es, más o menos, lo que subiría el mar si se derritiera todo el hielo del planeta."
  },
  {
   "ini": 95.96,
   "fim": 99.47,
   "texto": "Groenlandia, la Antártida, todos los glaciares."
  },
  {
   "ini": 101.24,
   "fim": 105.98,
   "texto": "Ciento ochenta y cuatro millones de latinoamericanos ya estarían bajo el agua."
  },
  {
   "ini": 107.48,
   "fim": 108.3,
   "texto": "Pero hay algo extraño."
  },
  {
   "ini": 109.6,
   "fim": 113.89,
   "texto": "Si la Antártida se derritiera, cerca de ella el mar no subiría."
  },
  {
   "ini": 114.68,
   "fim": 115.4,
   "texto": "Bajaría."
  },
  {
   "ini": 116.58,
   "fim": 121.39,
   "texto": "Su hielo es tan pesado que atrae el océano con su propia gravedad, como un imán."
  },
  {
   "ini": 122.52,
   "fim": 124.48,
   "texto": "Al derretirse, lo suelta."
  },
  {
   "ini": 125.28,
   "fim": 132.12,
   "texto": "Y esa agua se va lejos, justo hacia nuestras costas, donde subiría más que el promedio."
  },
  {
   "ini": 133.52,
   "fim": 135.68,
   "texto": "Desde aquí, ya no queda hielo que derretir."
  },
  {
   "ini": 136.26,
   "fim": 138.68,
   "texto": "Lo que sigue es imaginación."
  },
  {
   "ini": 139.8,
   "fim": 140.54,
   "texto": "Y el mar sigue subiendo."
  },
  {
   "ini": 142.75,
   "fim": 144.46,
   "texto": "Doscientos dieciocho metros."
  },
  {
   "ini": 145.88,
   "fim": 146.78,
   "texto": "Cae el primer país."
  },
  {
   "ini": 148.22,
   "fim": 149.48,
   "texto": "Y no es una isla del Caribe."
  },
  {
   "ini": 150.44,
   "fim": 151.42,
   "texto": "Es Uruguay."
  },
  {
   "ini": 152.38,
   "fim": 157.28,
   "texto": "Uno de los países más planos del continente: casi toda su gente vive cerca del agua."
  },
  {
   "ini": 158.4,
   "fim": 162.36,
   "texto": "Los últimos uruguayos resisten en el norte, en Rivera y Tacuarembó."
  },
  {
   "ini": 163.72,
   "fim": 166.12,
   "texto": "Catorce metros después, cae Cuba."
  },
  {
   "ini": 167.66,
   "fim": 172.72,
   "texto": "La cuenca del Amazonas, casi toda por debajo de doscientos metros, ya es un mar interior."
  },
  {
   "ini": 173.94,
   "fim": 177.3,
   "texto": "Más de la mitad de la tierra de Latinoamérica es océano."
  },
  {
   "ini": 178.5,
   "fim": 181.76,
   "texto": "A seiscientos dieciocho metros cae Paraguay."
  },
  {
   "ini": 182.76,
   "fim": 185.8,
   "texto": "A ochocientos noventa y siete, República Dominicana."
  },
  {
   "ini": 187.98,
   "fim": 188.6,
   "texto": "Mil metros."
  },
  {
   "ini": 189.98,
   "fim": 193.32,
   "texto": "Tres de cada cuatro latinoamericanos ya están bajo el agua."
  },
  {
   "ini": 194.44,
   "fim": 198.98,
   "texto": "El Salvador, Nicaragua y Panamá caen en menos de cuarenta metros."
  },
  {
   "ini": 200.0,
   "fim": 205.49,
   "texto": "Brasil, el gigante, aguanta hasta mil doscientos cuarenta y ocho, en la meseta de Brasilia."
  },
  {
   "ini": 206.9,
   "fim": 210.14,
   "texto": "Y a mil trescientos treinta y cinco metros cae Argentina."
  },
  {
   "ini": 211.02,
   "fim": 211.26,
   "texto": "Sí."
  },
  {
   "ini": 211.84,
   "fim": 218.14,
   "texto": "El país del Aconcagua, la montaña más alta de toda América, cae en el décimo lugar."
  },
  {
   "ini": 219.2,
   "fim": 219.84,
   "texto": "¿Cómo puede ser?"
  },
  {
   "ini": 220.8,
   "fim": 221.58,
   "texto": "Guarda esa pregunta."
  },
  {
   "ini": 222.78,
   "fim": 224.7,
   "texto": "Cuarenta metros después, Haití."
  },
  {
   "ini": 226.12,
   "fim": 229.18,
   "texto": "Venezuela cae a mil quinientos ochenta y uno."
  },
  {
   "ini": 229.94,
   "fim": 232.94,
   "texto": "Honduras, a mil setecientos treinta y nueve."
  },
  {
   "ini": 233.88,
   "fim": 236.78,
   "texto": "Costa Rica, a mil ochocientos siete."
  },
  {
   "ini": 237.96,
   "fim": 240.84,
   "texto": "Chile llega a dos mil doscientos cuarenta."
  },
  {
   "ini": 241.82,
   "fim": 246.0,
   "texto": "Sus últimos habitantes viven en el desierto de Atacama, en Calama."
  },
  {
   "ini": 246.88,
   "fim": 252.36,
   "texto": "Y a dos mil doscientos ochenta metros, el agua llega a la Ciudad de México."
  },
  {
   "ini": 253.34,
   "fim": 257.54,
   "texto": "Donde hace quinientos años había un lago, vuelve a haber agua."
  },
  {
   "ini": 258.98,
   "fim": 262.12,
   "texto": "Bogotá se hunde a dos mil quinientos ochenta."
  },
  {
   "ini": 263.02,
   "fim": 264.68,
   "texto": "Ahora la pelea es entre tres."
  },
  {
   "ini": 265.26,
   "fim": 269.22,
   "texto": "México cae a dos mil setecientos cuarenta y cinco, con sus últimos en Toluca."
  },
  {
   "ini": 270.04,
   "fim": 272.5,
   "texto": "Colombia, a dos mil novecientos tres."
  },
  {
   "ini": 273.12,
   "fim": 275.74,
   "texto": "Guatemala, a dos mil novecientos cincuenta."
  },
  {
   "ini": 276.88,
   "fim": 279.34,
   "texto": "Tres países, en apenas doscientos metros."
  },
  {
   "ini": 280.6,
   "fim": 285.34,
   "texto": "A tres mil metros, el noventa y ocho por ciento de los latinoamericanos ya está bajo el agua."
  },
  {
   "ini": 286.88,
   "fim": 292.87,
   "texto": "Ahora sí: ¿por qué Argentina, con la montaña más alta, cayó tan pronto?"
  },
  {
   "ini": 294.42,
   "fim": 295.96,
   "texto": "Porque el mar no busca montañas."
  },
  {
   "ini": 296.8,
   "fim": 297.6,
   "texto": "Busca personas."
  },
  {
   "ini": 298.22,
   "fim": 301.02,
   "texto": "Y en los Andes, las personas eligieron vivir arriba."
  },
  {
   "ini": 301.78,
   "fim": 302.72,
   "texto": "Por una razón física."
  },
  {
   "ini": 303.8,
   "fim": 307.46,
   "texto": "El aire que sube se expande, y al expandirse se enfría."
  },
  {
   "ini": 308.16,
   "fim": 310.98,
   "texto": "Por cada kilómetro de altura, unos cuatro grados menos."
  },
  {
   "ini": 311.96,
   "fim": 315.38,
   "texto": "En la costa de Ecuador, Guayaquil vive a veintiséis grados."
  },
  {
   "ini": 316.32,
   "fim": 321.28,
   "texto": "Subes casi tres kilómetros y llegas a Quito: unos catorce grados, todo el año."
  },
  {
   "ini": 321.88,
   "fim": 325.5,
   "texto": "Una primavera eterna, sin el calor ni los mosquitos de la selva."
  },
  {
   "ini": 326.42,
   "fim": 332.04,
   "texto": "Por eso hace más de mil años ya había ciudades a casi cuatro mil metros, como Tiwanaku."
  },
  {
   "ini": 332.68,
   "fim": 337.1,
   "texto": "Y por eso hoy millones de personas viven en el cielo."
  },
  {
   "ini": 338.76,
   "fim": 341.54,
   "texto": "Ecuador cae a tres mil trescientos treinta y ocho."
  },
  {
   "ini": 342.36,
   "fim": 346.06,
   "texto": "Cusco, la capital de los incas, se hunde poco después."
  },
  {
   "ini": 347.52,
   "fim": 347.9,
   "texto": "Quedan dos."
  },
  {
   "ini": 348.58,
   "fim": 349.94,
   "texto": "Bolivia y Perú."
  },
  {
   "ini": 350.7,
   "fim": 353.1,
   "texto": "El mismo altiplano, el mismo lago."
  },
  {
   "ini": 354.46,
   "fim": 357.06,
   "texto": "El agua sube desde la selva por el cañón de La Paz."
  },
  {
   "ini": 357.86,
   "fim": 369.02,
   "texto": "Y a tres mil ochocientos cincuenta y un metros cruza el último paso del altiplano: el Titicaca, el lago navegable más alto del mundo, se une al océano."
  },
  {
   "ini": 370.2,
   "fim": 371.76,
   "texto": "El Alto, Potosí."
  },
  {
   "ini": 372.66,
   "fim": 375.88,
   "texto": "Bolivia cae a cuatro mil ciento cuarenta y nueve metros."
  },
  {
   "ini": 376.92,
   "fim": 378.24,
   "texto": "Y Perú sigue en pie."
  },
  {
   "ini": 379.34,
   "fim": 383.67,
   "texto": "Sus últimos habitantes, en Cerro de Pasco y en los pueblos mineros de la puna."
  },
  {
   "ini": 385.06,
   "fim": 387.42,
   "texto": "Perú gana por setenta y dos metros."
  },
  {
   "ini": 388.84,
   "fim": 390.32,
   "texto": "Pero el agua no se detiene."
  },
  {
   "ini": 390.78,
   "fim": 397.2,
   "texto": "A cinco mil cien metros se hunde La Rinconada, el pueblo más alto del mundo."
  },
  {
   "ini": 398.18,
   "fim": 398.9,
   "texto": "Ya no queda nadie."
  },
  {
   "ini": 400.12,
   "fim": 402.58,
   "texto": "Y la última roca seca de Latinoamérica..."
  },
  {
   "ini": 403.28,
   "fim": 404.2,
   "texto": "es argentina."
  },
  {
   "ini": 405.22,
   "fim": 409.78,
   "texto": "La cumbre del Aconcagua, a seis mil novecientos sesenta y un metros."
  },
  {
   "ini": 411.32,
   "fim": 414.6,
   "texto": "El país de la montaña más alta perdió antes que casi todos."
  },
  {
   "ini": 415.94,
   "fim": 417.54,
   "texto": "Pero se queda con la última piedra."
  },
  {
   "ini": 419.06,
   "fim": 420.62,
   "texto": "¿Algo de esto es real?"
  },
  {
   "ini": 421.62,
   "fim": 429.54,
   "texto": "Los primeros setenta metros podrían pasar si se derritiera todo el hielo del planeta, pero en miles de años, no en uno."
  },
  {
   "ini": 430.58,
   "fim": 436.45,
   "texto": "Todo lo demás es imaginación, calculada con el relieve real y con el lugar donde vive cada persona."
  },
  {
   "ini": 437.84,
   "fim": 439.16,
   "texto": "¿En qué metro cayó tu país?"
  },
  {
   "ini": 440.1,
   "fim": 440.68,
   "texto": "Te leo en los comentarios."
  }
 ]
}